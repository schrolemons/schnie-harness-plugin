{
  "name": "dsh-schnie-archive",
  "version": "0.4.0",
  "description": "Native DeepSeek Harness retrieval context and source cards using the current session model",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schrolemons/schnie-harness-plugin.git"
  },
  "homepage": "https://github.com/schrolemons/schnie-harness-plugin#readme",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts/check-public.mjs",
    ".private-prompt-fingerprints.json",
    "scripts/pack-release.mjs",
    "VALIDATION.md",
    "docs/architecture.md",
    "protocol/",
    "docs/protocol.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "vitest run",
    "check": "node scripts/check.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "privacy:check": "node scripts/check-public.mjs",
    "privacy:history": "node scripts/check-public.mjs --history",
    "build:client": "node scripts/build-client.mjs",
    "prepack": "npm run build:client && npm run check",
    "demo:sse": "node examples/sse-server.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vitest": "5.0.5"
  }
}
